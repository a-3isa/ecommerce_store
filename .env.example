# Copy to .env.development for `npm run start:dev`, or to .env.production
# for `npm run start:prod` and docker compose. The app does not read `.env`.
# Every value below is a placeholder.

PORT=3000

# PostgreSQL. TypeORM synchronises the schema on start (synchronize: true).
# In docker compose, use DB_HOST=postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=ecommerce_store

# Signs login tokens. Required: the app refuses to start without it.
JWT_SECRET=replace-with-a-long-random-string

# Redis cache. In docker compose, use REDIS_HOST=redis.
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ queue for order-confirmation emails. In docker compose, use the host rabbitmq.
RABBITMQ_URI=amqp://guest:guest@localhost:5672

# Stripe. STRIPE_SECRET_KEY is required at startup; the webhook secret is
# needed by POST /order/webhook (from `stripe listen` or the Stripe dashboard).
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# SMTP server for order-confirmation emails (for example a Mailtrap sandbox).
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=replace-me
MAIL_PASS=replace-me

# Cloudinary, for product images uploaded with POST /product.
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
